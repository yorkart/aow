[Unit]
Description=AoW Host daemon (local Agent, terminal and workspace operations)
After=network.target

[Service]
Type=exec
EnvironmentFile=-%h/.aow/server.env
ExecStart=%h/.local/lib/aow/bin/aow-host-daemon
UMask=0077
Restart=on-failure
RestartSec=1s
TimeoutStopSec=30s

[Install]
WantedBy=default.target
