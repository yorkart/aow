#!/usr/bin/env bash
set -euo pipefail
umask 077

# Resolve the installed symlink before loading the helper from this release.
script_path=$(node -e 'process.stdout.write(require("node:fs").realpathSync(process.argv[1]))' "${BASH_SOURCE[0]}")
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../scripts/server-state-dir.sh
source "$(dirname -- "$script_path")/../../scripts/server-state-dir.sh"
stage=
account_pending_file=
cleanup() {
    [[ -z "$account_pending_file" ]] || rm -f -- "$account_pending_file"
    [[ -z "$stage" ]] || rm -rf -- "$stage"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
usage() {
    cat <<'HELP'
Usage: aow update [--version VERSION] [--repo OWNER/REPO]
       aow account

account           Set or change the local login account and password; no server restart needed.

Update from the saved GitHub repository, following its latest release.
--version VERSION  Install a specific GitHub release tag.
--repo OWNER/REPO Use a different GitHub repository and remember it after activation.
-h, --help         Show help without downloading or changing services.

Repository priority: --repo > AOW_RELEASE_REPOSITORY > saved repository > yorkart/aow.
Only a lowercase y entered at the terminal permits starting/restarting terminald.
HELP
}
account_command() {
    local if_missing=0
    while (( $# )); do
        case "$1" in
            --if-missing) if_missing=1; shift ;;
            -h|--help)
                printf '%s\n' 'Usage: aow account [--if-missing]' \
                    'Set a local login account and password. Password input is hidden and confirmed.' \
                    '--if-missing  Keep existing credentials.json (used during installation/startup).'
                return ;;
            *) fail "unknown account argument: $1" ;;
        esac
    done
    local state_dir account_file account_tty=9 username password confirm
    state_dir=$(server_state_dir)
    account_file=$state_dir/credentials.json
    if (( if_missing )) && [[ -f "$account_file" ]]; then return; fi
    [[ ! -d "$account_file" ]] || fail "Account destination is a directory: $account_file"
    if ! { exec 9<>/dev/tty; } 2>/dev/null; then
        fail '账户设置需要交互终端；请在终端重新运行安装，或执行 aow account。'
    fi
    [[ -t "$account_tty" ]] || fail '账户设置需要交互终端。'
    if (( if_missing )); then
        printf '%s\n' '首次使用必须先设置 AoW 登录账号和密码，保存后才能启动 server。' >&"$account_tty"
    fi
    while :; do
        printf '%s' '请输入登录账号: ' >&"$account_tty"
        if ! IFS= read -r -u "$account_tty" username; then
            printf '\n' >&"$account_tty"
            fail '账户输入已取消，未保存账号和密码。'
        fi
        if printf '%s' "$username" | node -e '
            const value = require("node:fs").readFileSync(0, "utf8");
            process.exit(value.length > 0 && Buffer.byteLength(value) <= 256 && !/[\p{White_Space}\p{Cc}]/u.test(value) ? 0 : 1);
        '; then break; fi
        printf '%s\n' '账号不能为空、不能包含空白或控制字符，且不能超过 256 字节，请重新输入。' >&"$account_tty"
    done
    while :; do
        printf '%s' '请输入登录密码: ' >&"$account_tty"
        if ! IFS= read -r -s -u "$account_tty" password; then
            printf '\n' >&"$account_tty"
            fail '账户输入已取消，未保存账号和密码。'
        fi
        printf '\n' >&"$account_tty"
        if ! printf '%s' "$password" | node -e '
            const size = require("node:fs").readFileSync(0).length;
            process.exit(size > 0 && size <= 1024 ? 0 : 1);
        '; then
            printf '%s\n' '密码不能为空，且不能超过 1024 字节，请重新输入。' >&"$account_tty"
            continue
        fi
        printf '%s' '请再次输入密码: ' >&"$account_tty"
        if ! IFS= read -r -s -u "$account_tty" confirm; then
            printf '\n' >&"$account_tty"
            fail '账户输入已取消，未保存账号和密码。'
        fi
        printf '\n' >&"$account_tty"
        if [[ "$password" == "$confirm" ]]; then break; fi
        printf '%s\n' '两次输入的密码不一致，请重新输入。' >&"$account_tty"
    done
    exec 9>&-
    mkdir -p -- "$state_dir"
    account_pending_file=$(mktemp "$state_dir/.credentials.json.XXXXXX")
    # Credentials travel only over stdin, never process arguments or environment.
    printf '%s\0%s' "$username" "$password" | node -e '
        const { pbkdf2Sync, randomBytes } = require("node:crypto");
        const input = require("node:fs").readFileSync(0);
        const separator = input.indexOf(0);
        const salt = randomBytes(16);
        process.stdout.write(JSON.stringify({
            version: 1,
            username: input.subarray(0, separator).toString("utf8"),
            salt: salt.toString("hex"),
            password_hash: pbkdf2Sync(input.subarray(separator + 1), salt, 600000, 32, "sha256").toString("hex"),
        }) + "\n");
    ' >"$account_pending_file"
    unset username password confirm
    chmod 0600 "$account_pending_file"
    node -e 'require("node:fs").renameSync(process.argv[1], process.argv[2])' "$account_pending_file" "$account_file"
    account_pending_file=
    printf '账号和密码已保存到 %s；请使用账号和密码登录网页，无需重启 server。\n' "$account_file"
}
config_value() {
    node --input-type=module - "$runtime_root/update.json" "$1" <<'JS'
import { readFileSync } from 'node:fs';
const [path, field] = process.argv.slice(2);
try {
    const value = JSON.parse(readFileSync(path, 'utf8'))[field];
    if (value != null && typeof value !== 'string') throw new Error(`invalid ${field}`);
    process.stdout.write(value || '');
} catch (error) {
    if (error.code !== 'ENOENT') {
        console.error(`error: cannot read update configuration: ${error.message}`);
        process.exit(1);
    }
}
JS
}
main() {
    case "${1:-}" in
        ''|-h|--help) usage; return ;;
        account) shift; account_command "$@"; return ;;
        update) shift ;;
        *) fail "unknown command: $1 (use: aow update / aow account)" ;;
    esac
    local repository=${AOW_RELEASE_REPOSITORY:-} version=''
    while (( $# )); do
        case "$1" in
            --repo|--version)
                if (( $# < 2 )) || [[ -z "$2" ]]; then fail "$1 requires a value"; fi
                if [[ "$1" == --repo ]]; then repository=$2; else version=$2; fi
                shift 2 ;;
            -h|--help) usage; return ;;
            *) fail "unknown argument: $1" ;;
        esac
    done
    if [[ -n "$version" ]]; then
        [[ "$version" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$version" != latest ]] \
            || fail "invalid version: $version"
    fi
    local runtime_root=${HOME:?HOME must be set}/.local/lib/aow
    [[ ${AOW_RUNTIME_ROOT:-$runtime_root} == "$runtime_root" ]] \
        || fail 'aow update requires ~/.local/lib/aow as AOW_RUNTIME_ROOT'
    command -v node >/dev/null || fail 'Node.js 20+ is required'
    if [[ -z "$repository" ]]; then repository=$(config_value repository); fi
    repository=${repository:-yorkart/aow}
    [[ "$repository" =~ ^[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$ ]] \
        || fail '--repo must be a GitHub repository in OWNER/REPO form'
    local installer_url=https://github.com/$repository/releases/latest/download/aow-install.sh
    local user_bin_dir=${AOW_USER_BIN_DIR:-}
    if [[ -z "$user_bin_dir" ]]; then user_bin_dir=$(config_value user_bin_dir); fi
    user_bin_dir=${user_bin_dir:-$HOME/.local/bin}
    [[ "$user_bin_dir" == /* ]] || fail 'the command directory must be an absolute path'
    export AOW_USER_BIN_DIR=$user_bin_dir
    command -v curl >/dev/null || fail 'curl is required for updates'
    stage=$(mktemp -d "$runtime_root/.update.XXXXXX")
    printf 'Downloading installer from %s\n' "$installer_url"
    curl --fail --show-error --location --retry 3 --connect-timeout 15 \
        --proto '=https' --proto-redir '=https' \
        --output "$stage/aow-install.sh" "$installer_url"
    [[ -s "$stage/aow-install.sh" ]] || fail 'downloaded installer is empty'
    bash -n "$stage/aow-install.sh"
    local -a args=(--repo "$repository")
    if [[ -n "$version" ]]; then args+=(--version "$version"); fi
    # Invoke the same public installer; it owns version resolution, installation,
    # configuration persistence and terminald confirmation. Keep EXIT cleanup here.
    bash "$stage/aow-install.sh" "${args[@]}"
}
main "$@"
