{
  "name": "aow-frontend-orbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.16.0 || >=24.0.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0 && stylelint 'src/**/*.css' --max-warnings 0 && html-validate index.html",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "html-validate": "10.17.0",
    "playwright": "^1.60.0",
    "stylelint": "16.26.1",
    "stylelint-config-recommended": "16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "^6.0.7"
  }
}
